# frozen_string_literal: true

require "bundler/gem_tasks"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("sghtmltopdf.gemspec")

RbSys::ExtensionTask.new("sghtmltopdf", GEMSPEC) do |ext|
  ext.lib_dir = "lib/sghtmltopdf"
  # クロスビルドの対象は docs/decisions/0061-distribution.md 決定3。
  # 実際のビルドはoxidize-rb/cross-gem-actionがCIで行う(T348)。
  ext.cross_compile = true
  ext.cross_platform = %w[x86_64-linux aarch64-linux arm64-darwin]
end

# クロスビルド(rb-sys-dockのコンテナ内)ではテスト用のgemが入っていない
# ことがある。`rake native:<platform> gem`だけは動くようにしておく。
begin
  require "rspec/core/rake_task"
  RSpec::Core::RakeTask.new(:spec)
  task spec: :compile
  task default: %i[compile spec]
rescue LoadError
  task default: :compile
end

# `bundler/gem_tasks`の`release`は「ソースgemを1つbuild → gitタグを作る →
# push」という**純Rubyのgem向け**の手順で、このgemには合わない。
#
# * 配布するのはprecompiled gem 3プラットフォーム + ソースgemの計4つ
#   (docs/decisions/0061-distribution.md 決定3・決定7)。CIがクロスビルド
#   したものを`pkg/`へ集めてから出す
# * gitタグは人が打ち、**そのタグのpushがリリースのトリガ**なので、
#   ここでタグを作ろうとすると「既にある」で失敗する
#
# `rubygems/release-gem`が実行するのはこの`rake release`なので、中身を
# 差し替えることで、公式アクションの利点(trusted publishingの設定・
# sigstore attestations・反映待ち)をそのまま使える。attestationsは
# `RUBYOPT`で挿し込まれるため、ここで呼ぶ`gem push`すべてに効く。
Rake::Task["release"].clear

desc "pkg/配下のgemをすべてrubygems.orgへpushする(CIから使う)"
task :release do
  gems = Dir["pkg/*.gem"].sort
  raise "pkg/にgemがありません。先にクロスビルドと`rake build`を済ませてください" if gems.empty?

  gems.each do |path|
    puts "pushing #{path}"
    sh("gem", "push", path)
  end
end
