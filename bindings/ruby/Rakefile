# frozen_string_literal: true

require "bundler/gem_tasks"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("sghtmltopdf.gemspec")

RbSys::ExtensionTask.new("sghtmltopdf", GEMSPEC) do |ext|
  ext.lib_dir = "lib/sghtmltopdf"
  # oxidize-rb/cross-gem-action
  ext.cross_compile = true
  ext.cross_platform = %w[
    x86_64-linux aarch64-linux
    x86_64-linux-musl aarch64-linux-musl
    arm64-darwin
  ]
end

begin
  require "rspec/core/rake_task"
  RSpec::Core::RakeTask.new(:spec)
  task spec: :compile
  task default: %i[compile spec]
rescue LoadError
  task default: :compile
end

# `bundler/gem_tasks`の`release`は
# 「ソースgemを1つbuild → gitタグを作る → push」という処理になっているが、
# CIでのクロスビルドでは
# 「ソースgemを1つbuild → gitタグを作る → push → precompiled gemを5つbuild → push」という流れにしたいので、
# `release`タスクを差し替える。
Rake::Task["release"].clear

desc "pkg/配下のgemをすべてrubygems.orgへpushする(CIから使う)"
task :release do
  gems = Dir["pkg/*.gem"].sort
  raise "pkg/にgemがありません。先にクロスビルドと`rake build`を済ませてください" if gems.empty?

  gems.each do |path|
    puts "pushing #{path}"
    sh("gem", "push", path)
  end
end
